# AI Studio Environment Setup
# Populate these values in your Google AI Studio Secrets UI

# --- Common ---
NODE_ENV=development

# --- Backend ---
# Required for Gemini AI Chat
GOOGLE_GENAI_API_KEY=

# External DBs (Because AI Studio does not host these natively)
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# JWT & Webhooks
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
WEBHOOK_SECRET=your_webhook_signing_secret

# AI Models (Pinecone + HF used in original codebase)
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX=embediq-index
HUGGINGFACE_API_KEY=your_huggingface_key

# --- Frontend ---
VITE_API_URL=http://localhost:5000/api
